# NAS credentials — KHÔNG commit file này
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# Các tuyến vào NAS, thử theo đúng thứ tự này. Tuyến nào không với tới được trong
# NAS_PROBE_TIMEOUT giây thì bỏ qua, sang tuyến kế.
#   1. LAN     — nhanh nhất, chỉ chạy được khi máy ở cùng mạng công ty
#   2. Tailscale — vào được từ bất cứ đâu miễn máy đã join tailnet
#   3. WebDAV public — fallback cuối, không cần tailscale
#
# LƯU Ý: WebDAV của Synology chạy ở cổng 5005 (HTTP). Cổng 5000 là giao diện DSM,
# KHÔNG phải WebDAV — đã kiểm chứng: PROPFIND 5005 trả 207, 5000 trả 200 (trang HTML).
NAS_URL_1=http://192.168.x.x:5005/
NAS_URL_2=http://100.x.x.x:5005/
NAS_URL_3=https://nas.example.com/

NAS_PROBE_TIMEOUT=4

# Windows dùng SMB/UNC thay vì WebDAV (SMB native trên Windows, nhanh khi ở LAN).
# Chỉ cần hostname, không cần cổng. Thử theo thứ tự, không tuyến nào được thì
# nas-mount.bat quay sang map ổ WebDAV bằng NAS_URL_3.
NAS_SMB_1=192.168.x.x
NAS_SMB_2=100.x.x.x
